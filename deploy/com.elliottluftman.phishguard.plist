<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.elliottluftman.phishguard</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>cd /Users/elliottluftman/odoo-embeddings/PhishGuard && ./scripts/start_prod.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>WorkingDirectory</key>
    <string>/Users/elliottluftman/odoo-embeddings/PhishGuard</string>

    <key>StandardOutPath</key>
    <string>/tmp/phishguard.out.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/phishguard.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PHISHGUARD_DEBUG</key>
        <string>false</string>
        <key>PHISHGUARD_LOG_LEVEL</key>
        <string>INFO</string>
        <key>PHISHGUARD_SECRET_KEY</key>
        <string>replace-with-strong-secret</string>
    </dict>
</dict>
</plist>
